{
    "name": "webmultipliers/examplepress-mu",
    "description": "ExamplePress MU Platform Kernel",
    "type": "wordpress-muplugin",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "ExamplePress\\MU\\": "examplepress-mu/src/"
        }
    },
    "require": {
        "php": ">=8.1",
        "blockstudio/blockstudio": "*"
