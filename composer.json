{
    "name": "webmultipliers/examplepress-mu",
    "description": "ExamplePress MU Platform Kernel",
    "type": "wordpress-muplugin",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "ExamplePress\\MU\\": "examplepress-mu/src/"
        }
    },
    "require": {
        "php": ">=8.2",
        "blockstudio/blockstudio": "*",
        "prism-php/prism": "~0.100.0",
        "woocommerce/action-scheduler": "^3.8",
        "illuminate/container": "^12.0",
        "illuminate/config": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/events": "^12.0",
        "illuminate/http": "^12.0"
    },
    "replace": {
        "laravel/framework": "12.99.99"
    },
    "config": {
        "optimize-autoloader": true,
        "vendor-dir": "examplepress-mu/vendor",
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "build:php": "@composer install --no-dev --optimize-autoloader --classmap-authoritative --no-interaction --prefer-dist",
        "build:js": [
            "npm ci",
            "npm run build"
        ],
        "build": [
            "@build:php",
            "@build:js"
        ]
    }
}
