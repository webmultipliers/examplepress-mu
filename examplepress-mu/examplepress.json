{
    "$schema": "./schema/examplepress-app.json",
    "name": "ExamplePress MU",
    "slug": "examplepress-mu",
    "description": "A self-updating WordPress MU plugin that auto-installs from GitHub releases.",
    "updater": {
        "github_repo": "webmultipliers/examplepress-mu",
        "asset_filename": "examplepress-mu.zip",
        "default_channel": "stable",
        "requires_wp": "6.4",
        "requires_php": "8.1"
    },
    "features": {
        "title-tag": true,
        "responsive-embeds": true,
        "post-thumbnails": true,
        "wp-block-styles": true,
        "html5": true,
        "disable-remote-block-patterns": true,
        "disable-core-block-patterns": true,
        "restrict-block-types": false,
        "openverse": false,
        "post-lock-window": true,
        "remove-dashboard-widgets": true,
        "login-branding": true,
        "theme-colors": true,
        "theme-layout": true,
        "theme-typography": true,
        "design-strict": false,
        "theme-spacing": false,
        "theme-borders": false,
        "theme-shadows": false,
        "theme-global-styles": false
    },
    "dependencies": []
}
